<view class="container">
  <view class="header">
    <text class="title">{{isLogin ? '老板登录' : '店铺注册'}}</text>
  </view>
  
  <view class="form">
    <view class="input-item">
      <input class="input" placeholder="请输入手机号" placeholder-class="ph" type="number" maxlength="11" bindinput="onPhoneInput" value="{{phone}}" />
    </view>

    <view class="input-item">
      <input class="input" placeholder="请输入密码" placeholder-class="ph" password bindinput="onPasswordInput" value="{{password}}" />
      <view class="toggle-pwd" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view>
    </view>
    <view wx:if="{{showPassword}}" class="pwd-show-row">
      <text class="pwd-show-label">当前输入：</text>
      <text class="pwd-show-value">{{password}}</text>
    </view>

    <view class="input-item" wx:if="{{!isLogin}}">
      <input class="input" placeholder="请输入店铺名称" placeholder-class="ph" bindinput="onShopNameInput" value="{{shopName}}" />
    </view>

    <view class="input-item" wx:if="{{!isLogin}}">
      <input class="input" placeholder="请输入真实姓名(选填)" placeholder-class="ph" bindinput="onRealNameInput" value="{{realName}}" />
    </view>

    <view class="input-item" wx:if="{{!isLogin}}">
      <input class="input" placeholder="推荐码(选填)" placeholder-class="ph" bindinput="onReferralCodeInput" value="{{referralCode}}" maxlength="6" />
    </view>

    <!-- 用户协议与隐私政策授权 -->
    <view class="agree-row">
      <view class="agree-checkbox" bindtap="toggleAgree">
        <text class="agree-icon">{{hasAgreed ? '✓' : ''}}</text>
      </view>
      <text class="agree-text">我已阅读并同意</text>
      <text class="agree-link" bindtap="showAgreement">《用户服务协议》</text>
      <text class="agree-text">和</text>
      <text class="agree-link" bindtap="showPrivacy">《隐私政策》</text>
    </view>

    <button class="btn-submit {{hasAgreed ? '' : 'disabled'}}" bindtap="submit" disabled="{{!hasAgreed}}">{{isLogin ? '登录' : '注册'}}</button>
    
    <view class="toggle-mode" bindtap="toggleMode">
      <text>{{isLogin ? '没有账号？去注册' : '已有账号？去登录'}}</text>
    </view>
    
    <view class="divider">
      <view class="line"></view>
      <text class="or">或</text>
      <view class="line"></view>
    </view>
    
    <button class="btn-wechat" bindtap="onWechatLogin">微信一键登录</button>
  </view>

  <!-- 微信登录协议弹窗 -->
  <view class="wechat-agree-mask" wx:if="{{showWechatAgreeModal}}" bindtap="closeWechatAgreeModal"></view>
  <view class="wechat-agree-popup" wx:if="{{showWechatAgreeModal}}">
    <view class="wechat-agree-title">用户协议与隐私政策</view>
    <view class="wechat-agree-body">
      <text>欢迎使用食易特Eat！我们将依据</text>
      <text class="agree-link" bindtap="showAgreement">《用户服务协议》</text>
      <text>和</text>
      <text class="agree-link" bindtap="showPrivacy">《隐私政策》</text>
      <text>处理您的个人信息。</text>
    </view>
    <view class="wechat-agree-check-row">
      <view class="agree-checkbox" bindtap="toggleWechatAgree">
        <text class="agree-icon">{{wechatAgreed ? '✓' : ''}}</text>
      </view>
      <text class="agree-text">我已阅读并同意上述协议</text>
    </view>
    <view class="wechat-agree-btn {{wechatAgreed ? '' : 'disabled'}}" bindtap="confirmWechatLogin">确认并登录</view>
    <view class="wechat-agree-cancel" bindtap="closeWechatAgreeModal">取消</view>
  </view>
</view>
