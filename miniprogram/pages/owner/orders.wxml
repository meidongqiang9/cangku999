<view class="container">
  <view class="tabs">
    <view class="tab {{filter === 'today' ? 'active' : ''}}" bindtap="setFilter" data-filter="today">今日</view>
    <view class="tab {{filter === 'month' ? 'active' : ''}}" bindtap="setFilter" data-filter="month">本月</view>
    <view class="tab {{filter === 'year' ? 'active' : ''}}" bindtap="setFilter" data-filter="year">本年</view>
  </view>

  <view class="summary">
    <view class="summary-row">
      <view class="summary-item">
        <text class="label">桌数</text>
        <text class="value">{{orderCount}}桌</text>
      </view>
      <view class="summary-item">
        <text class="label">总额</text>
        <text class="value">{{totalAmount}}</text>
      </view>
      <view class="summary-item">
        <text class="label">已结桌</text>
        <text class="value completed">{{completedCount}}桌</text>
      </view>
    </view>
    <view class="summary-row">
      <view class="summary-item">
        <text class="label">已结</text>
        <text class="value completed">{{completedAmount}}</text>
      </view>
      <view class="summary-item">
        <text class="label">人流</text>
        <text class="value">{{guestCount}}人</text>
      </view>
      <view class="summary-item">
      </view>
    </view>
  </view>

  <view class="order-list">
    <view wx:for="{{orders}}" wx:key="createdAt" class="order-card" bindtap="showDetail" data-index="{{index}}">
      <view class="order-card-header">
        <text class="order-no">{{item.tableNo}}桌</text>
        <text class="order-time">{{item.timeText}}</text>
      </view>
      <view class="order-card-summary">
        <text class="summary-stat">{{item.items.length}}道菜</text>
        <text class="summary-stat">{{item.guestCount}}人</text>
        <text class="summary-stat highlight">💰{{item.totalPrice}}</text>
      </view>
      <view class="order-card-footer">
        <text class="status {{item.status}}">{{item.statusText}}</text>
        <text class="detail-arrow">查看明细 ›</text>
      </view>
    </view>

    <view wx:if="{{orders.length === 0}}" class="empty">暂无订单</view>
  </view>

  <!-- 明细弹窗 -->
  <view class="detail-mask" wx:if="{{showDetailPopup}}" bindtap="closeDetail"></view>
  <view class="detail-popup" wx:if="{{showDetailPopup}}">
    <view class="detail-popup-title">{{detailOrder.tableNo}}桌 · 结账单</view>
    <view class="detail-table">
      <block wx:for="{{detailOrder.detailGroups}}" wx:key="title">
        <view class="detail-section-label {{item.isOwner ? 'owner' : ''}}">{{item.title}} · {{item.items.length}}道</view>
        <view class="detail-head">
          <text class="d-col-name">菜品</text>
          <text class="d-col-qty">数量</text>
          <text class="d-col-price">单价</text>
          <text class="d-col-sub">小计</text>
        </view>
        <view wx:for="{{item.items}}" wx:for-item="d" wx:key="name" class="detail-row {{item.isOwner ? 'owner-row' : ''}}">
          <view class="d-col-name-wrap">
            <text class="d-col-name">{{d.name}}</text>
            <text wx:if="{{d.taste}}" class="taste-tag">{{d.taste}}</text>
          </view>
          <text class="d-col-qty">x{{d.quantity}}</text>
          <text class="d-col-price">💰{{d.price}}</text>
          <text class="d-col-sub">💰{{d.price * d.quantity}}</text>
        </view>
      </block>
    </view>
    <view class="detail-total">
      <text>合计</text>
      <text class="detail-total-val">💰{{detailOrder.totalPrice}}</text>
    </view>
    <view class="detail-close-btn" bindtap="closeDetail">关闭</view>
  </view>
</view>