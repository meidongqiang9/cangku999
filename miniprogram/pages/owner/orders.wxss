page { background: #f5f5f5 }

.container { min-height: 100vh }

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #5B8C5A;
  border-bottom: 4rpx solid #5B8C5A;
}

.summary {
  background: linear-gradient(135deg, #5B8C5A 0%, #7BA37B 100%);
  padding: 24rpx;
}

.summary-row {
  display: flex;
  margin-bottom: 16rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.label { 
  color: rgba(255,255,255,0.8); 
  font-size: 22rpx;
}

.value {
  color: #fff; 
  font-size: 32rpx; 
  font-weight: 700; 
  margin-top: 4rpx;
}

.value.completed {
  color: #ffeb3b;
}

.order-list { padding: 24rpx }

.order-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
}

.order-no { font-size: 30rpx; font-weight: 600; color: #333 }

.guest-count {
  font-size: 24rpx;
  color: #5B8C5A;
  font-weight: normal;
  margin-left: 12rpx;
}

.order-time { font-size: 24rpx; color: #999 }

.order-dishes {
  font-size: 24rpx;
  color: #666;
  margin: 12rpx 0;
  line-height: 1.6;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status.pending { background: #fff3e0; color: #ff9800 }
.status.completed { background: #e8f5e9; color: #4caf50 }

.amount { font-size: 30rpx; color: #5B8C5A; font-weight: 600 }

.empty { text-align: center; padding: 60rpx; color: #999 }