@import '../../../theme.wxss';

page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}

/* —— 成功图标 —— */
.success-icon-wrap {
  margin-bottom: var(--space-lg);
}

.success-icon {
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, var(--secondary), #7DC87F);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 76rpx;
  color: #fff;
  box-shadow: 0 8rpx 36rpx rgba(107, 175, 110, 0.3);
  animation: success-pop 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes success-pop {
  from { transform: scale(0); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.success-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.success-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: var(--space-2xl);
}

/* —— 提示卡片 —— */
.tip-card {
  width: 82%;
  text-align: center;
  padding: var(--space-lg);
  margin-bottom: var(--space-2xl);
}

.tip-card text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.tip-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* —— 返回按钮 —— */
.btn-primary {
  width: 82%;
}