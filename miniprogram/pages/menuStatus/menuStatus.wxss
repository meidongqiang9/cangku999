page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
}

.page-title {
  background: #5B8C5A;
  color: #fff;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.tabs {
  display: flex;
  background: #fff;
}

.tab {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #5B8C5A;
  font-weight: 500;
  border-bottom: 4rpx solid #5B8C5A;
}

.order-list {
  padding: 24rpx;
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.table-no {
  font-size: 32rpx;
  font-weight: 600;
}

.time {
  color: #999;
  font-size: 24rpx;
}

.dish-item {
  padding: 8rpx 0;
  color: #666;
  font-size: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-item.served {
  color: #999;
}

.btn-serve {
  background: #5B8C5A;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.served-tag {
  color: #5B8C5A;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #5B8C5A;
  border-radius: 4rpx;
}

.action-btns {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-action {
  background: #5B8C5A;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 48rpx;
}