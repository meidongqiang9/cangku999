page { background: #f5f5f5 }

.container { min-height: 100vh }

.header {
  background: #5B8C5A;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title { font-size: 32rpx; color: #fff; font-weight: 600 }
.add-btn { color: #fff; font-size: 28rpx }

.table-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
}

.table-item {
  width: calc(25% - 16rpx);
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.table-item.occupied {
  background: #5B8C5A;
  color: #fff;
}

.table-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.table-item.occupied .table-name { color: #fff }

.table-status {
  font-size: 22rpx;
  color: #4CAF50;
  margin-top: 8rpx;
}

.table-item.occupied .table-status { color: #fff }

.table-amount {
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.table-guest {
  font-size: 20rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 4rpx;
}

.table-item.occupied .table-amount { color: #fff }

.table-item.add {
  border: 2rpx dashed #ddd;
  color: #999;
}

.table-item.add .table-name { font-size: 40rpx; color: #999 }

/* 自定义输入弹窗 */
.input-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.input-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 101;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-input {
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.placeholder { color: #999 }

.popup-btns {
  display: flex;
}

.popup-cancel,
.popup-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-cancel {
  background: #f5f5f5;
  color: #666;
  margin-right: 16rpx;
}

.popup-confirm {
  background: #5B8C5A;
  color: #fff;
}