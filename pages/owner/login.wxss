page { background: #f5f5f5 }

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 80rpx 60rpx 60rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #5B8C5A;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
}

.login-form {
  background: #fff;
  margin: 20rpx 32rpx;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 48rpx;
}

.input-group {
  margin-bottom: 24rpx;
  position: relative;
}

.input {
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.password-group .input {
  padding-right: 80rpx;
}

.toggle-eye {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  padding: 10rpx;
}

.btn-primary {
  background: #5B8C5A;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}

.toggle-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #5B8C5A;
}

.bottom-tips {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #999;
}

.link {
  color: #5B8C5A;
}