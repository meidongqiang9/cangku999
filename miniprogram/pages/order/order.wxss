@import '../../theme.wxss';

page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 180rpx;
}

/* —— 顶部标题栏 —— */
.page-title {
  background: linear-gradient(160deg, #E8784A, #F09060);
  color: #fff;
  padding: 28rpx var(--space-md);
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

/* —— 状态概览 —— */
.status-summary {
  display: flex;
  background: var(--bg-card);
  padding: 28rpx 0;
  margin: 0 var(--space-md);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1;
}

.status-num.served { color: var(--secondary); }
.status-num.total { color: var(--accent); }

.status-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  font-weight: 500;
}

.status-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--border-light);
  align-self: center;
}

/* —— 桌号信息（基准宽度）—— */
.table-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  margin: var(--space-md);
  padding: var(--space-md);
  font-weight: 600;
}

.total-price-text {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary);
}

/* —— 菜品列表 —— */
.order-scroll {
  flex: 1;
  padding: 0 var(--space-md);
}

.order-group {
  margin-bottom: var(--space-md);
}

.group-title {
  padding: var(--space-md) 4rpx var(--space-sm);
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 600;
}

/* —— 分区标签 —— */
.order-section-divider {
  padding: 28rpx 0 12rpx;
  text-align: center;
}

.section-label {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 8rpx 28rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
}

/* 终端协助分区 — 背景框宽度与桌号卡片一致，右侧向中心收缩 */
.owner-group {
  background: var(--accent-light);
  border-radius: var(--radius-md);
  padding: 4rpx 0;
  margin: 8rpx 0;
}

.owner-group .dish-row {
  background: transparent;
  box-shadow: none;
}

/* —— 菜品行 — 宽度与桌号卡片一致 —— */
.dish-row {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx var(--space-md);
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
}

.dish-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.status-dot.submitted { background: var(--warning); }
.status-dot.served { background: var(--secondary); }
.status-dot.returned { background: var(--danger); }

.dish-info-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.taste-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.dish-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-name.returned-text {
  color: #C8BFB5;
  text-decoration: line-through;
}

.dish-qty {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 右侧状态标签 — 向中心收缩，不靠右 */
.dish-right {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.dish-status-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
}

.dish-status-tag.submitted {
  background: var(--warning-light);
  color: var(--warning);
}

.dish-status-tag.served {
  background: var(--success-light);
  color: var(--success);
}

.dish-status-tag.returned {
  background: var(--danger-light);
  color: var(--danger);
}

/* —— 底部操作栏 —— */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--bg-card);
  box-shadow: var(--shadow-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  font-size: 24rpx;
  font-weight: 600;
}

.action-btn.add {
  background: var(--bg-card);
  color: var(--primary);
  border-right: 1rpx solid var(--border-light);
}

.action-btn.checkout {
  background: linear-gradient(160deg, #E8784A, #F09060);
  color: #fff;
}

.action-btn.checkout.disabled {
  background: #D5CFC8;
  color: var(--text-tertiary);
}

.action-btn:active { opacity: 0.85; }

.action-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

/* —— 空状态 —— */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: var(--text-tertiary);
  gap: 8rpx;
}