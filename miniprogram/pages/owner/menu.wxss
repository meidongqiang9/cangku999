page { background: #f5f5f5 }

.container { min-height: 100vh }

.header {
  background: #5B8C5A;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title { font-size: 32rpx; color: #fff; font-weight: 600 }

.add-btn { color: #fff; font-size: 28rpx }

.category-list {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.category-item {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  margin: 8rpx;
  font-size: 26rpx;
}

.category-item.active {
  background: #5B8C5A;
  color: #fff;
}

.delete-btn {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #999;
}

.category-item.active .delete-btn { color: #fff }

.dish-list { padding: 24rpx }

.dish-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.dish-img {
  width: 120rpx;
  height: 120rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #ccc;
}

.dish-info {
  flex: 1;
  margin-left: 16rpx;
}

.dish-name { font-size: 28rpx; font-weight: 600 }

.dish-desc { font-size: 22rpx; color: #999; margin-top: 4rpx }

.dish-price { color: #5B8C5A; font-size: 28rpx; margin-top: 8rpx }

.dish-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.action-btn {
  font-size: 22rpx;
  color: #5B8C5A;
  padding: 8rpx 16rpx;
  border: 1rpx solid #5B8C5A;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  text-align: center;
}

.action-btn.delete {
  color: #f00;
  border-color: #f00;
}

.add-dish {
  background: #fff;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  padding: 32rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 自定义输入弹窗 */
.input-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.input-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 101;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.edit-dish-name {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #333;
}

.dish-image-upload {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin: 0 auto 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.image-upload-placeholder {
  font-size: 24rpx;
  color: #999;
}

.popup-input {
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.placeholder {
  color: #999;
}

.popup-btns {
  display: flex;
}

.popup-cancel,
.popup-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-cancel {
  background: #f5f5f5;
  color: #666;
  margin-right: 16rpx;
}

.popup-confirm {
  background: #5B8C5A;
  color: #fff;
}