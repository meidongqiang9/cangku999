page { background: #f5f5f5 }

.container { min-height: 100vh }

.header {
  background: #5B8C5A;
  padding: 24rpx;
  text-align: center;
}

.title { font-size: 32rpx; color: #fff; font-weight: 600 }

.section {
  background: #fff;
  margin: 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.banner-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.banner-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.banner-thumb {
  width: 100%;
  height: 100%;
}

.banner-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 36rpx;
  border-radius: 50%;
}

.banner-add {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #999;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.input-row:last-child { border-bottom: none }

.label {
  width: 160rpx;
  font-size: 26rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 26rpx;
}

.qrcode-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.hint { font-size: 24rpx; color: #999 }

.link {
  font-size: 22rpx;
  color: #5B8C5A;
  margin: 12rpx 0;
  word-break: break-all;
  text-align: center;
}

.btn-copy {
  background: #5B8C5A;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.btn-save {
  margin: 40rpx 24rpx;
  background: #5B8C5A;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}