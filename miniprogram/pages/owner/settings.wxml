<view class="container">
  <view class="header">
    <text class="title">界面设置</text>
  </view>
  
  <view class="section">
    <view class="section-title">基本信息</view>
    <view class="input-row">
      <text class="label">店铺名称</text>
      <input class="input" value="{{shopName}}" bindinput="onShopNameInput"/>
    </view>
    <view class="input-row">
      <text class="label">联系电话</text>
      <input class="input" value="{{phone}}" bindinput="onPhoneInput"/>
    </view>
  </view>

  <view class="section">
    <view class="section-title">扫码通知 <text class="hint-text">(餐桌码扫描后弹出)</text></view>
    <view class="input-row">
      <text class="label">通知标题</text>
      <input class="input" value="{{noticeTitle}}" bindinput="onNoticeTitleInput" placeholder="通知"/>
    </view>
    <view class="input-row">
      <text class="label">通知内容</text>
      <textarea class="textarea" value="{{noticeContent}}" bindinput="onNoticeContentInput" placeholder="请输入欢迎语或通知内容" maxlength="100"/>
    </view>
    <view class="preview-btn" bindtap="previewNotice">预览通知弹窗</view>
  </view>
  
  <view class="section">
    <view class="section-title">首页轮播图 <text class="hint-text">({{banners.length}}/8张 · 每行4张)</text></view>
    <text class="banner-tip">点击 + 添加图片，支持多张自动轮播</text>
    <view class="input-row">
      <text class="label">首页标题</text>
      <input class="input" value="{{homeTitle}}" bindinput="onHomeTitleInput" placeholder="首页显示标题"/>
    </view>
    <view class="banner-list">
      <view wx:for="{{banners}}" wx:key="*this" class="banner-item">
        <image class="banner-thumb" src="{{item}}" mode="aspectFill" />
        <view class="banner-remove" bindtap="removeBanner" data-index="{{index}}">×</view>
      </view>
      <view wx:if="{{banners.length < 8}}" class="banner-add" bindtap="addBanner">
        <text class="banner-add-icon">+</text>
      </view>
    </view>
  </view>
  
  <!-- 收米设置暂时隐藏：个人用户需公司资质才能使用微信支付收款功能，代码保留 -->
  <view class="section" wx:if="{{false}}">
    <view class="section-title">收米设置</view>
    <view class="input-row">
      <text class="label">收米通道</text>
      <picker bindchange="onPayTypeChange" value="{{payType}}" range="{{['微信zhifu商户', '个人收款码']}}">
        <view class="picker-value">{{payType === 0 ? '微信zhifu商户' : '个人收款码'}}</view>
      </picker>
    </view>

    <block wx:if="{{payType === 0}}">
      <view class="input-row">
        <text class="label">商户号</text>
        <input class="input" value="{{mchId}}" bindinput="onMchIdInput" placeholder="微信zhifu商户号"/>
      </view>
      <view class="input-row">
        <text class="label">商户密钥</text>
        <input class="input" password="true" value="{{mchKey}}" bindinput="onMchKeyInput" placeholder="API密钥"/>
      </view>
    </block>

    <block wx:if="{{payType === 1}}">
      <view class="input-row">
        <text class="label">个人收款码</text>
        <view class="qrcode-upload" bindtap="uploadQrcode">
          <image wx:if="{{personalQrcode}}" src="{{personalQrcode}}" mode="aspectFill" class="qrcode-img"/>
          <view wx:else class="qrcode-placeholder">+ 上传收款码</view>
        </view>
      </view>
    </block>
  </view>
  
  <view class="section">
    <view class="section-title">二维码</view>
    <view class="qrcode-area">
      <text class="hint">店铺链接：</text>
      <text class="link">{{qrcodeUrl}}</text>
      <view class="btn-copy" bindtap="copyLink">复制链接</view>
    </view>
  </view>
  
  <view class="btn-save" bindtap="saveSettings">保存设置</view>

  <!-- 通知预览弹窗 -->
  <view class="preview-mask" wx:if="{{showPreview}}" bindtap="closePreview"></view>
  <view class="preview-popup" wx:if="{{showPreview}}">
    <view class="preview-title-bar">{{noticeTitle || '通知'}}</view>
    <view class="preview-body">{{noticeContent || '顾客扫码后将看到此内容'}}</view>
    <view class="preview-btn-close" bindtap="closePreview">我知道了</view>
  </view>
</view>