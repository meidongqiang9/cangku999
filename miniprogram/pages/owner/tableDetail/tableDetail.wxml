<view class="container">
  <view class="header">
    <text class="title">{{table.name}}</text>
  </view>

  <view class="total-row">
    <text>顾客</text>
    <text class="total">💰{{totalPrice}}</text>
  </view>
  <view class="total-row owner-total" wx:if="{{ownerTotal > 0}}">
    <text>协助点餐</text>
    <text class="total owner">💰{{ownerTotal}}</text>
  </view>
  <view class="total-row total-all">
    <text>合计</text>
    <text class="total all">💰{{totalAll}}</text>
  </view>

  <scroll-view scroll-y class="item-list">
    <block wx:for="{{allItems}}" wx:for-item="group">
      <view class="group-section" wx:if="{{group.items.length > 0}}">
        <view class="section-head">
          <text>{{group.title}} · {{group.items.length}}道</text>
          <text class="section-subtotal">💰{{group.subtotal}}</text>
        </view>

        <view class="table-header">
          <text class="th-name">菜品</text>
          <text class="th-qty">数量</text>
          <text class="th-price">单价</text>
          <text class="th-sub">小计</text>
        </view>

        <!-- 普通菜品行 -->
        <block wx:if="{{group.title !== '终端协助'}}">
          <view wx:for="{{group.items}}" wx:key="id" class="table-row">
            <view class="td-name-wrap">
              <text class="td-name">{{item.name}}</text>
              <text wx:if="{{item.taste}}" class="taste-tag">{{item.taste}}</text>
            </view>
            <text class="td-qty">×{{item.quantity}}</text>
            <text class="td-price">💰{{item.price}}</text>
            <text class="td-sub">💰{{item.price * item.quantity}}</text>
          </view>
        </block>

        <!-- 终端协助：数量、单价直接输入数字 -->
        <block wx:if="{{group.title === '终端协助'}}">
          <view wx:for="{{group.items}}" wx:key="id" class="table-row row-owner">
            <view class="td-name-wrap">
              <text class="td-name">{{item.name}}</text>
              <text wx:if="{{item.taste}}" class="taste-tag">{{item.taste}}</text>
            </view>
            <input class="td-input-qty" type="number" value="{{item.quantity}}" bindblur="onOwnerQtyBlur" data-itemid="{{item.id}}" data-docid="{{item._id}}" maxlength="3"/>
            <input class="td-input-price" type="digit" value="{{item.price}}" bindblur="onOwnerPriceBlur" data-itemid="{{item.id}}" data-docid="{{item._id}}" data-originalprice="{{item.originalPrice}}" maxlength="6"/>
            <text class="td-sub">💰{{item.price * item.quantity}}</text>
          </view>
        </block>
      </view>
    </block>
  </scroll-view>

  <view class="btn-add" bindtap="addDish">+ 加菜</view>
  <view class="btn-reset" bindtap="resetTable">翻台清台</view>
</view>