.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx }

.header {
  background: #5B8C5A;
  color: #fff;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.section {
  background: #fff;
  margin: 24rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}

.section.total {
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: bold;
}

.table-label { font-size: 28rpx; color: #999; display: block; margin-bottom: 8rpx }

.table-no { font-size: 48rpx; font-weight: bold; color: #333; display: block; margin-bottom: 20rpx }

.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 12rpx }

.item-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-name { flex: 1; font-size: 26rpx }

.item-qty { color: #999; width: 100rpx; text-align: center }

.item-price { width: 100rpx; text-align: right; color: #5B8C5A }

.total-price { color: #5B8C5A; font-size: 36rpx }

.btn-home {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx; right: 24rpx;
  background: #5B8C5A;
  color: #fff;
  padding: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}