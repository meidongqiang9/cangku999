page { background: #f5f5f5 }

.container { min-height: 100vh; padding-bottom: 40rpx }

.page-title {
  background: #5B8C5A;
  color: #fff;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.section {
  background: #fff;
  margin: 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.input-row:last-child { border-bottom: none }

.label {
  width: 160rpx;
  font-size: 26rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.qrcode-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.qrcode-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.qrcode-link {
  font-size: 22rpx;
  color: #5B8C5A;
  word-break: break-all;
  margin-bottom: 16rpx;
}

.btn-small {
  background: #5B8C5A;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.btn-save {
  margin: 40rpx 24rpx;
  background: #5B8C5A;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.data-row {
  display: flex;
}

.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #5B8C5A;
  margin-bottom: 8rpx;
}

.data-label {
  font-size: 24rpx;
  color: #999;
}