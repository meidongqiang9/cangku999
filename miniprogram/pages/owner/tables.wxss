@import '../../theme.wxss';

page { background: var(--bg-page) }
.container { min-height: 100vh }

/* —— 顶部 —— */
.header {
  background: linear-gradient(160deg, #E8784A, #F09060);
  padding: var(--space-md) var(--space-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title { font-size: 34rpx; color: #fff; font-weight: 700 }
.add-btn { color: #fff; font-size: 28rpx; font-weight: 600 }

/* —— 餐桌网格 —— */
.table-grid {
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-md);
}

.table-item {
  width: calc(25% - 16rpx);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx 10rpx;
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-card);
  transition: transform 120ms;
}

.table-item:active { transform: scale(0.96) }

.table-item.occupied {
  background: var(--primary);
  color: #fff;
}

.table-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.table-item.occupied .table-name { color: #fff }

.table-status {
  font-size: 22rpx;
  color: var(--secondary);
  margin-top: 6rpx;
  font-weight: 600;
}

.table-item.occupied .table-status { color: rgba(255,255,255,0.9) }

.table-amount {
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 4rpx;
  color: var(--primary);
}

.table-guest {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}

.table-item.occupied .table-amount { color: #fff }

/* —— 添加餐桌 —— */
.table-item.add {
  border: 2rpx dashed var(--border);
  box-shadow: none;
}

.table-item.add .table-name { font-size: 44rpx; color: var(--text-tertiary) }

/* —— QR 缩略图 —— */
.qr-thumb {
  width: 64rpx;
  height: 64rpx;
  margin-top: 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--border-light);
}

.table-item.occupied .qr-thumb { border-color: rgba(255,255,255,0.35) }

/* —— 操作按钮 —— */
.table-actions {
  display: flex;
  gap: 4rpx;
  margin-top: 10rpx;
}

.table-action-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.04);
  color: var(--text-secondary);
}

.table-item.occupied .table-action-btn {
  background: rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.85);
}

.table-action-btn.delete { color: var(--danger) }
.table-item.occupied .table-action-btn.delete { color: rgba(255,255,255,0.85) }

/* —— QR 码弹窗 —— */
.qr-popup {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  z-index: 101;
  box-shadow: var(--shadow-elevated);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-full {
  width: 380rpx;
  height: 380rpx;
  margin-bottom: var(--space-md);
}

.qr-generating {
  width: 380rpx;
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.qr-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--space-md);
}

.qr-btns {
  display: flex;
  align-items: center;
  gap: 36rpx;
  width: 100%;
  justify-content: center;
}

.qr-btn-close {
  padding: 18rpx 44rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: var(--bg-page);
  border-radius: var(--radius-full);
  font-weight: 500;
}

.qr-btn-regen {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8784A, #F09060);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(232,120,74,0.35);
}

.regen-line {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 4rpx;
}

/* —— 弹窗通用 —— */
.input-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}

.input-popup {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  z-index: 101;
  box-shadow: var(--shadow-elevated);
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: var(--space-lg);
  color: var(--text-primary);
}

.popup-input {
  height: 84rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  font-size: 28rpx;
  margin-bottom: var(--space-md);
  border: 2rpx solid transparent;
  width: 100%;
  box-sizing: border-box;
}

.popup-input:focus { border-color: var(--primary); background: var(--bg-card) }

.popup-btns { display: flex }

.popup-cancel, .popup-confirm {
  flex: 1;
  height: 84rpx;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.popup-cancel {
  background: var(--bg-page);
  color: var(--text-secondary);
  margin-right: var(--space-sm);
}

.popup-confirm {
  background: linear-gradient(135deg, var(--primary), #F09060);
  color: #fff;
}