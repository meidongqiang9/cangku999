<view class="container">
  <!-- 顶部海报轮播 -->
  <swiper class="banner-swiper" autoplay="{{true}}" interval="{{3000}}" circular="{{true}}">
    <swiper-item wx:for="{{banners}}" wx:key="*this">
      <image class="banner-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
    <swiper-item wx:if="{{banners.length === 0}}">
      <view class="banner-placeholder">
        <text class="banner-title">{{homeTitle}}</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 桌号（锁定显示） -->
  <view class="input-section card">
    <view class="table-locked-display">
      <text class="table-locked-label">桌号</text>
      <text class="table-locked-value">🔒 {{tableNo}}</text>
    </view>
    <view class="input-item">
      <view class="label">就餐人数</view>
      <input
        class="input"
        placeholder="请输入人数"
        value="{{guestCount}}"
        bindinput="onGuestInput"
        type="number"
        maxlength="2"
        focus="{{!guestCount}}"
      />
    </view>
  </view>

  <!-- 开始点餐 -->
  <view class="btn-primary start-btn" bindtap="startOrder">查看菜谱</view>

  <!-- 通知弹窗 -->
  <view class="notice-mask" wx:if="{{showNotice}}" bindtap="closeNotice"></view>
  <view class="notice-popup" wx:if="{{showNotice}}">
    <view class="notice-title">{{noticeTitle}}</view>
    <view class="notice-body">{{noticeContent}}</view>
    <view class="notice-btn" bindtap="closeNotice">我知道了</view>
  </view>

  <!-- 骨架屏 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="skeleton banner-skeleton"></view>
    <view class="skeleton input-skeleton"></view>
    <view class="skeleton btn-skeleton"></view>
  </view>
</view>
