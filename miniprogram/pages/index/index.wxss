page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  position: relative;
}

/* 轮播海报 */
.banner-swiper {
  width: 100%;
  height: 340rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 340rpx;
  background: linear-gradient(135deg, #5B8C5A, #7BA37B);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 8rpx;
}

/* 扫码区域 */
.scan-area {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  border-top: 2rpx dashed #eee;
}

.scan-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.scan-text {
  font-size: 28rpx;
  color: #5B8C5A;
}

/* 输入区域 */
.input-section {
  margin: 32rpx 24rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  box-sizing: border-box;
  color: #1a1a1a;
}

.input:focus {
  background: #eef5ee;
  border: 2rpx solid #5B8C5A;
}

/* 继续点餐 */
.continue-btn {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid #FF8C42;
}

.continue-btn text {
  color: #FF8C42;
  font-size: 28rpx;
  font-weight: 500;
}

/* 开始点餐按钮 */
.start-btn {
  margin: 8rpx 24rpx 32rpx;
}

.start-btn.disabled {
  background: #ccc;
}

/* 底部入口 */
.bottom-entries {
  display: flex;
  justify-content: center;
  padding: 24rpx;
  gap: 48rpx;
}

.entry-item {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #999;
}

/* 骨架屏 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f5f5f5;
  z-index: 999;
  padding: 24rpx;
}

.banner-skeleton {
  height: 340rpx;
  border-radius: 0;
}

.input-skeleton {
  height: 200rpx;
  margin: 32rpx 0;
  border-radius: 16rpx;
}

.btn-skeleton {
  height: 88rpx;
  margin-top: 32rpx;
  border-radius: 44rpx;
}
