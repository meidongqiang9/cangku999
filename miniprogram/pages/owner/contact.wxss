.container {
  padding: 40rpx;
}
.header {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid #eee;
}
.content {
  padding: 40rpx 0;
}
.info-item {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.label {
  color: #666;
  font-size: 30rpx;
}
.value {
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
}
.tips {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-top: 40rpx;
}