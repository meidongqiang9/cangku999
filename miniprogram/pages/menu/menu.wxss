@import '../../theme.wxss';

page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* —— 顶部 —— */
.header {
  background: linear-gradient(160deg, #E8784A, #F09060);
  padding: 24rpx var(--space-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.header-table {
  color: rgba(255,255,255,0.75);
  font-size: 24rpx;
}

.header-guest {
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  background: rgba(255,255,255,0.15);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}

/* —— 提示栏 —— */
.owner-bar {
  background: var(--accent-light);
  color: #B87A14;
  text-align: center;
  padding: 10rpx var(--space-md);
  font-size: 24rpx;
  font-weight: 500;
}

.ordered-bar {
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
  padding: 16rpx var(--space-md);
  font-size: 26rpx;
  font-weight: 600;
}

/* —— 主体布局 —— */
.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  height: calc(100vh - 140rpx);
}

/* —— 左侧品类导航 —— */
.category-nav {
  width: 170rpx;
  background: var(--bg-card);
  flex-shrink: 0;
}

.category-item {
  padding: 28rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 200ms;
}

.category-item.active {
  color: var(--primary);
  background: var(--primary-light);
  font-weight: 700;
  font-size: 28rpx;
}

.category-dot {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: var(--primary);
  border-radius: 0 4rpx 4rpx 0;
}

/* —— 右侧菜品区域 —— */
.dish-scroll {
  flex: 1;
  padding: 12rpx;
  height: 100%;
}

/* —— 菜品卡片：大图+信息 —— */
.dish-card {
  background: var(--bg-card);
  border-radius: var(--food-card-radius);
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: var(--food-card-shadow);
  transition: transform 150ms ease-out;
}

.dish-card:active {
  transform: scale(0.985);
}

/* 菜品图片区域 — 16:9比例 */
.dish-image-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-image-placeholder {
  width: 100%;
  height: 220rpx;
  background: linear-gradient(135deg, #FFF0E8, #FFE4D6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

/* 左上角已点徽章 */
.dish-qty-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
}

.badge-num {
  background: rgba(232, 120, 74, 0.92);
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 700;
}

/* —— 菜品信息行：菜名 + 数量控件 + 价格（同一行）—— */
.dish-info {
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.dish-name {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.dish-info-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.dish-price {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 800;
  white-space: nowrap;
  min-width: 80rpx;
  text-align: right;
}

/* —— 数量控件（行内）—— */
.qty-ctrl {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.qty-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.qty-btn.minus {
  background: #F5F0EB;
  color: var(--primary);
  border: 2rpx solid #EDE4D8;
}

.qty-btn.plus {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(232,120,74,0.25);
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* —— 加号按钮（行内）—— */
.add-btn {
  width: 52rpx;
  height: 44rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  box-shadow: 0 2rpx 10rpx rgba(232,120,74,0.3);
}

.add-btn:active {
  opacity: 0.8;
  transform: scale(0.9);
}

/* —— 已走菜标记（行内）—— */
.added-tag {
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  white-space: nowrap;
  font-weight: 500;
}

/* —— 底部提交栏（参考图2/3的购物车栏）—— */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx var(--space-md);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bottom-bar-bg);
  box-shadow: var(--shadow-bottom);
  z-index: 200;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.submit-btn {
  flex: 1;
  background: linear-gradient(135deg, var(--primary), #F09060);
  color: #fff;
  padding: 22rpx var(--space-md);
  border-radius: var(--radius-full);
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--shadow-button);
  letter-spacing: 2rpx;
}

.submit-btn:active {
  opacity: 0.85;
}

.back-order-btn {
  flex: 1;
  background: var(--bg-card);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  padding: 22rpx;
  border-radius: var(--radius-full);
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* —— 菜品详情弹层（右侧滑入）—— */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 900;
}

.detail-panel {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 560rpx;
  background: var(--bg-card);
  z-index: 1000;
  transform: translateX(100%);
  transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.detail-panel.show {
  transform: translateX(0);
}

.detail-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0,0,0,0.35);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  z-index: 2;
}

.detail-image {
  width: 100%;
  height: 380rpx;
}

.detail-image-placeholder {
  width: 100%;
  height: 380rpx;
  background: linear-gradient(135deg, #FFF0E8, #FFE4D6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.detail-body {
  flex: 1;
  padding: var(--space-lg);
  overflow-y: auto;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.detail-price {
  font-size: 38rpx;
  color: var(--primary);
  font-weight: 800;
  margin-bottom: var(--space-md);
}

.detail-desc, .detail-ingredients {
  margin-bottom: 24rpx;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.detail-add-btn {
  margin: var(--space-lg) 0;
}

/* —— 确认走菜弹窗 —— */
.confirm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
}

.confirm-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  width: 580rpx;
  z-index: 1100;
  animation: popup-bounce 250ms ease-out;
  overflow: hidden;
}

@keyframes popup-bounce {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

.confirm-title {
  padding: var(--space-lg);
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  border-bottom: 1rpx solid var(--border-light);
  color: var(--text-primary);
}

.confirm-body {
  padding: var(--space-lg);
  text-align: center;
}

.confirm-count {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 700;
  margin-bottom: 20rpx;
}

.confirm-dish-list {
  max-height: 300rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.confirm-dish {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.confirm-dish-name { font-size: 28rpx; color: var(--text-primary); }
.confirm-dish-qty { font-size: 26rpx; color: var(--text-secondary); }

.confirm-hint {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 500;
}

.confirm-btns {
  display: flex;
  border-top: 1rpx solid var(--border-light);
}

.confirm-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.confirm-btn.cancel {
  color: var(--text-secondary);
  border-right: 1rpx solid var(--border-light);
}

.confirm-btn.ok {
  color: var(--primary);
}

/* —— 已点菜品弹窗 —— */
.ordered-popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
}

.ordered-popup {
  position: fixed;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  width: 600rpx;
  max-height: 72vh;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.ordered-popup-title {
  padding: var(--space-lg);
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  border-bottom: 1rpx solid var(--border-light);
  color: var(--text-primary);
}

.ordered-popup-body {
  flex: 1;
  padding: var(--space-sm) var(--space-lg);
  max-height: 50vh;
}

.ordered-popup-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.ordered-popup-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: var(--space-sm);
}

.ordered-popup-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: var(--space-xs);
}

.ordered-popup-qty {
  font-size: 26rpx;
  color: var(--text-secondary);
  min-width: 48rpx;
  text-align: right;
}

.ordered-popup-status {
  font-size: 22rpx;
  color: var(--warning);
  padding: 4rpx 12rpx;
  background: var(--warning-light);
  border-radius: var(--radius-full);
  font-weight: 500;
}

.ordered-popup-status.served {
  color: var(--success);
  background: var(--success-light);
}

.ordered-popup-close {
  padding: var(--space-md);
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-top: 1rpx solid var(--border-light);
  font-weight: 500;
}

/* —— 空状态 —— */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-tertiary);
  gap: 8rpx;
}