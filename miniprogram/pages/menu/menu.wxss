page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.header {
  background: #5B8C5A;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.header-guest {
  color: rgba(255,255,255,0.8);
  font-size: 26rpx;
}

/* 老板代客加菜提示栏 */
.owner-bar {
  background: #fff3cd;
  color: #856404;
  text-align: center;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* 已点菜单入口 */
.ordered-bar {
  background: #e8f5e9;
  color: #5B8C5A;
  text-align: center;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 主体布局 */
.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  height: calc(100vh - 160rpx);
}

/* 左侧品类导航 */
.category-nav {
  width: 180rpx;
  background: #fff;
  flex-shrink: 0;
  border-right: 1rpx solid #f0f0f0;
}

.category-item {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  position: relative;
  transition: color 200ms;
}

.category-item.active {
  color: #5B8C5A;
  background: #f0f7f0;
  font-weight: 600;
}

.category-dot {
  position: absolute;
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background: #5B8C5A;
  border-radius: 3rpx;
}

/* 右侧菜品滚动 */
.dish-scroll {
  flex: 1;
  padding: 16rpx;
  height: 100%;
}

/* 菜品卡片 */
.dish-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: transform 150ms ease-out;
}

.dish-card:active {
  transform: scale(0.98);
}

.dish-image-wrap {
  position: relative;
  width: 100%;
  height: 240rpx;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-image-placeholder {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #f0f7f0, #e8f0e8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.dish-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
}

.badge-count {
  background: #5B8C5A;
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}

.dish-info {
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-name {
  font-size: 28rpx;
  color: #1a1a1a;
  flex: 1;
}

.dish-price {
  font-size: 28rpx;
  color: #5B8C5A;
  font-weight: 600;
}

/* 加号按钮 */
.add-btn {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  background: #5B8C5A;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(91,140,90,0.3);
}

.add-btn:active {
  opacity: 0.8;
}

.added-tag {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #999;
  padding: 6rpx 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
}

/* 底部提交按钮 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
  z-index: 200;
}

.submit-btn {
  background: #5B8C5A;
  color: #fff;
  padding: 24rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.submit-btn:active {
  opacity: 0.8;
}

.back-order-btn {
  background: #fff;
  color: #5B8C5A;
  border: 2rpx solid #5B8C5A;
  padding: 20rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 28rpx;
  margin-top: 12rpx;
}

/* 菜品详情弹层 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 900;
}

.detail-panel {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 560rpx;
  background: #fff;
  z-index: 1000;
  transform: translateX(100%);
  transition: transform 250ms ease-out;
  display: flex;
  flex-direction: column;
}

.detail-panel.show {
  transform: translateX(0);
}

.detail-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.4);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  z-index: 1;
}

.detail-image {
  width: 100%;
  height: 360rpx;
}

.detail-image-placeholder {
  width: 100%;
  height: 360rpx;
  background: linear-gradient(135deg, #f0f7f0, #e8f0e8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.detail-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.detail-price {
  font-size: 36rpx;
  color: #5B8C5A;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.detail-desc,
.detail-ingredients {
  margin-bottom: 20rpx;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.detail-add-btn {
  margin: 32rpx 0;
}

/* 确认走菜弹窗 */
.confirm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
}

.confirm-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 24rpx;
  width: 560rpx;
  z-index: 1100;
  animation: popup-bounce 250ms ease-out;
}

@keyframes popup-bounce {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.confirm-title {
  padding: 32rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f0f0f0;
}

.confirm-body {
  padding: 32rpx;
  text-align: center;
}

.confirm-count {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.confirm-dish-list {
  max-height: 280rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
  padding: 0 16rpx;
}

.confirm-dish {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.confirm-dish-name {
  font-size: 26rpx;
  color: #333;
}

.confirm-dish-qty {
  font-size: 26rpx;
  color: #999;
}

.confirm-hint {
  font-size: 24rpx !important;
  color: #FF8C42 !important;
}

.confirm-btns {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.confirm-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
}

.confirm-btn.cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.confirm-btn.ok {
  color: #5B8C5A;
  font-weight: 600;
}

/* 已点菜品弹窗 */
.ordered-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
}

.ordered-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 24rpx;
  width: 600rpx;
  max-height: 70vh;
  z-index: 1100;
  display: flex;
  flex-direction: column;
}

.ordered-popup-title {
  padding: 32rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f0f0f0;
}

.ordered-popup-body {
  flex: 1;
  padding: 16rpx 32rpx;
  max-height: 50vh;
}

.ordered-popup-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ordered-popup-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.ordered-popup-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.ordered-popup-qty {
  font-size: 26rpx;
  color: #666;
  min-width: 48rpx;
  text-align: right;
}

.ordered-popup-status {
  font-size: 22rpx;
  color: #FF8C42;
  padding: 4rpx 12rpx;
  background: #fff3e0;
  border-radius: 6rpx;
  white-space: nowrap;
}

.ordered-popup-status.served {
  color: #4CAF50;
  background: #e8f5e9;
}

.ordered-popup-close {
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  border-top: 1rpx solid #f0f0f0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #999;
  gap: 8rpx;
}
