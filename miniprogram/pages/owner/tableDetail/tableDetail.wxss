.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 200rpx }

.header {
  background: linear-gradient(135deg, #5B8C5A 0%, #7BA37B 100%);
  padding: 40rpx;
}

.title { font-size: 36rpx; font-weight: bold; color: #fff }

.total-row {
  background: #fff;
  margin: 24rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
}

.total { font-size: 36rpx; font-weight: bold; color: #5B8C5A }

.item-list { margin: 24rpx; max-height: 60vh }

.group-section { background: #fff; margin-bottom: 24rpx; border-radius: 12rpx; padding: 20rpx }

.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 16rpx }

.subtotal { float: right; color: #5B8C5A }

.item-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-row.owner-item { background: #f0f7ff }

.item-info { flex: 1 }

.item-name { font-size: 28rpx }

.item-qty { color: #999; width: 80rpx; text-align: center }

.item-price { width: 80rpx; text-align: center; color: #333 }

.item-subtotal { width: 100rpx; text-align: right; color: #5B8C5A; font-weight: bold }

.price-btns { display: flex; align-items: center; width: 160rpx }

.price-btn {
  width: 44rpx; height: 44rpx;
  background: #5B8C5A; color: #fff;
  border-radius: 22rpx;
  text-align: center; line-height: 44rpx;
  font-size: 32rpx;
}

.price-btn.minus { background: #999 }

.owner-tag {
  background: #5B8C5A;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.btn-add {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  background: #5B8C5A;
  color: #fff;
  padding: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-reset {
  position: fixed;
  bottom: 140rpx;
  left: 24rpx;
  right: 24rpx;
  background: #f00;
  color: #fff;
  padding: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}