@import '../../theme.wxss';

page { background: var(--bg-page) }
.container { min-height: 100vh }

/* —— 标签栏 —— */
.tabs {
  display: flex;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-card);
}

.tab {
  flex: 1;
  padding: var(--space-md);
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  font-weight: 500;
}

.tab.active {
  color: var(--primary);
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 52rpx;
  height: 5rpx;
  background: var(--primary);
  border-radius: 3rpx;
}

/* —— 统计概览 —— */
.summary {
  background: linear-gradient(160deg, #E8784A, #F09060);
  padding: var(--space-md) var(--space-lg);
}

.summary-row {
  display: flex;
  margin-bottom: 12rpx;
}

.summary-row:last-child { margin-bottom: 0 }

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.label {
  color: rgba(255,255,255,0.8);
  font-size: 22rpx;
  font-weight: 500;
}

.value {
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 4rpx;
}

.value.completed { color: #FFE082 }

/* —— 订单列表 —— */
.order-list { padding: var(--space-md) }

.order-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 22rpx var(--space-md);
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-card);
}

.order-card:active { background: #FDF9F5 }

.order-card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.order-no { font-size: 30rpx; font-weight: 700; color: var(--text-primary) }
.order-time { font-size: 24rpx; color: var(--text-tertiary) }

.order-card-summary {
  display: flex;
  gap: 28rpx;
  padding: 8rpx 0;
}

.summary-stat {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.summary-stat.highlight {
  color: var(--primary);
  font-weight: 800;
  font-size: 28rpx;
}

.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6rpx;
}

.status {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
}

.status.pending { background: var(--warning-light); color: var(--warning) }
.status.completed, .status.paid { background: var(--success-light); color: var(--success) }

.detail-arrow { font-size: 24rpx; color: var(--primary); font-weight: 600 }

/* —— 空状态 —— */
.empty { text-align: center; padding: 80rpx; color: var(--text-tertiary) }

/* —— 订单明细弹窗 —— */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 900;
}

.detail-popup {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: var(--radius-xl);
  z-index: 1000;
  overflow: hidden;
  box-shadow: var(--shadow-elevated);
}

.detail-popup-title {
  background: linear-gradient(160deg, #E8784A, #F09060);
  color: #fff;
  padding: 26rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.detail-table {
  max-height: 50vh;
  overflow-y: auto;
  padding: 0 var(--space-md);
}

.detail-head {
  display: flex;
  padding: 18rpx 0;
  font-size: 24rpx;
  color: var(--text-tertiary);
  border-bottom: 1rpx solid var(--border-light);
  font-weight: 600;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  font-size: 28rpx;
}

.detail-row.owner-row {
  background: var(--accent-light);
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

/* 分组标签 */
.detail-section-label {
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
}
.detail-section-label.owner {
  color: var(--accent);
  margin-top: 16rpx;
  border-top: 1rpx dashed var(--border);
}

.d-col-name { flex: 2; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500 }

.d-col-name-wrap {
  flex: 2;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.d-col-name-wrap .d-col-name {
  flex: none;
  min-width: auto;
}

.taste-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.d-col-qty { flex: 1; color: var(--text-secondary); text-align: center }
.d-col-price { flex: 1.2; color: var(--text-secondary); text-align: right }
.d-col-sub { flex: 1.2; color: var(--primary); font-weight: 700; text-align: right }

.detail-total {
  display: flex;
  justify-content: space-between;
  padding: 22rpx var(--space-md);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  border-top: 2rpx solid var(--border);
}

.detail-total-val { color: var(--primary); font-weight: 800 }

.detail-close-btn {
  margin: 0 var(--space-md) var(--space-md);
  background: linear-gradient(135deg, var(--primary), #F09060);
  color: #fff;
  padding: 22rpx;
  border-radius: var(--radius-full);
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-close-btn:active { opacity: 0.85 }