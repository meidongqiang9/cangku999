@import '../../theme.wxss';

page { background: var(--bg-page) }
.container { min-height: 100vh }

/* —— 顶部 —— */
.header {
  background: linear-gradient(160deg, #E8784A, #F09060);
  padding: var(--space-md) var(--space-lg);
  text-align: center;
}

.title { font-size: 34rpx; color: #fff; font-weight: 700 }

/* —— 分区 —— */
.section {
  background: var(--bg-card);
  margin: var(--space-md);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--border-light);
  color: var(--text-primary);
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: normal;
}

/* —— 轮播图 —— */
.banner-list { display: flex; flex-wrap: wrap; gap: var(--space-sm) }
.banner-item {
  width: calc(25% - 12rpx); height: 160rpx; position: relative;
  border-radius: var(--radius-sm); overflow: hidden;
}

.banner-thumb { width: 100%; height: 100% }

.banner-remove {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  font-size: 24rpx; text-align: center; line-height: 36rpx;
  border-radius: 50%;
}

.banner-add {
  width: calc(25% - 12rpx); height: 160rpx;
  background: var(--bg-page); border-radius: var(--radius-sm);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  border: 2rpx dashed var(--border);
}

.banner-add-icon { font-size: 44rpx; color: var(--text-tertiary); line-height: 1 }
.banner-add-text { font-size: 20rpx; color: var(--text-tertiary); margin-top: 6rpx }

.banner-tip {
  display: block; font-size: 22rpx; color: var(--text-tertiary); margin-bottom: 10rpx;
}

/* —— 输入行 —— */
.input-row {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.input-row:last-child { border-bottom: none }

.label { width: 160rpx; font-size: 26rpx; color: var(--text-secondary); font-weight: 500 }

.input { flex: 1; font-size: 28rpx; color: var(--text-primary) }

.textarea {
  flex: 1; font-size: 28rpx; color: var(--text-primary);
  height: 120rpx; background: var(--bg-page);
  border-radius: var(--radius-md); padding: 16rpx; box-sizing: border-box;
}

/* —— 二维码区 —— */
.qrcode-area {
  display: flex; flex-direction: column; align-items: center; padding: var(--space-md);
}

.hint { font-size: 24rpx; color: var(--text-tertiary) }
.link { font-size: 22rpx; color: var(--primary); margin: 8rpx 0; word-break: break-all; text-align: center }

.btn-copy {
  background: var(--primary); color: #fff;
  padding: 12rpx 32rpx; border-radius: var(--radius-full); font-size: 26rpx; font-weight: 600;
}

/* —— 保存按钮 —— */
.btn-save {
  margin: var(--space-xl) var(--space-md);
  background: linear-gradient(135deg, var(--primary), #F09060);
  color: #fff; height: 88rpx; border-radius: var(--radius-full);
  font-size: 32rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button); font-weight: 700;
}

/* —— 通知预览 —— */
.preview-btn {
  margin-top: 12rpx; text-align: center; padding: 16rpx;
  font-size: 24rpx; color: var(--primary);
  border: 1rpx dashed var(--primary); border-radius: var(--radius-sm);
}

.preview-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1100;
}

.preview-popup {
  position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 560rpx; background: var(--bg-card); border-radius: var(--radius-xl);
  z-index: 1200; overflow: hidden;
}

.preview-title-bar {
  background: linear-gradient(160deg, #E8784A, #F09060);
  color: #fff; padding: 28rpx; text-align: center;
  font-size: 32rpx; font-weight: 700;
}

.preview-body {
  padding: 40rpx 32rpx; text-align: center; font-size: 30rpx;
  color: var(--text-primary); line-height: 1.6; min-height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  white-space: pre-wrap; word-break: break-all;
}

.preview-btn-close {
  margin: 0 32rpx 32rpx;
  background: linear-gradient(135deg, #E8784A, #F09060);
  color: #fff; padding: 22rpx; border-radius: var(--radius-full);
  text-align: center; font-size: 30rpx; font-weight: 700;
}