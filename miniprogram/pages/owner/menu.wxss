@import '../../theme.wxss';

page { background: var(--bg-page) }
.container { min-height: 100vh }

/* —— 顶部 —— */
.header {
  background: linear-gradient(160deg, #E8784A, #F09060);
  padding: var(--space-md) var(--space-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title { font-size: 34rpx; color: #fff; font-weight: 700 }
.add-btn { color: #fff; font-size: 28rpx; font-weight: 600 }

/* —— 分类标签 —— */
.category-list {
  display: flex;
  flex-wrap: wrap;
  background: var(--bg-card);
  padding: var(--space-sm) var(--space-md);
  margin-bottom: var(--space-xs);
  box-shadow: var(--shadow-card);
}

.category-item {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  padding: 12rpx 20rpx;
  border-radius: var(--radius-full);
  margin: 6rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.category-item.active {
  background: var(--primary);
  color: #fff;
}

.delete-btn {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.edit-cat-btn {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.category-item.active .delete-btn,
.category-item.active .edit-cat-btn { color: rgba(255,255,255,0.7) }

/* —— 菜品列表 —— */
.dish-list { padding: var(--space-md) }

.dish-item {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-sm);
  margin-bottom: var(--space-sm);
  box-shadow: var(--food-card-shadow);
}

.dish-img {
  width: 130rpx;
  height: 130rpx;
  background: var(--border-light);
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
}

.dish-image { width: 100%; height: 100%; }

.dish-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #FFF0E8, #FFE4D6);
}

.dish-info {
  flex: 1;
  margin-left: var(--space-sm);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dish-name { font-size: 28rpx; font-weight: 700; color: var(--text-primary) }
.dish-desc { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx }
.dish-price { color: var(--primary); font-size: 30rpx; font-weight: 800; margin-top: 8rpx }

.dish-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}

.action-btn {
  font-size: 22rpx;
  color: var(--primary);
  padding: 8rpx 18rpx;
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-sm);
  margin-bottom: 8rpx;
  text-align: center;
  font-weight: 600;
}

.action-btn.delete {
  color: var(--danger);
  border-color: var(--danger);
}

/* —— 添加菜品按钮 —— */
.add-dish {
  background: var(--bg-card);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  text-align: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
  font-weight: 500;
}

/* —— 弹窗通用 —— */
.input-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}

.input-popup {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  z-index: 101;
  box-shadow: var(--shadow-elevated);
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: var(--space-lg);
  color: var(--text-primary);
}

.edit-dish-name {
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: var(--space-md);
  color: var(--text-primary);
}

.dish-image-upload {
  width: 220rpx;
  height: 220rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  margin: 0 auto var(--space-md);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploaded-image { width: 100%; height: 100%; }
.image-upload-placeholder { font-size: 26rpx; color: var(--text-tertiary) }

.popup-input {
  height: 84rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  font-size: 28rpx;
  margin-bottom: var(--space-sm);
  border: 2rpx solid transparent;
  width: 100%;
  box-sizing: border-box;
}

.popup-input:focus { border-color: var(--primary); background: var(--bg-card) }

.popup-btns { display: flex; margin-top: var(--space-md) }

.popup-cancel, .popup-confirm {
  flex: 1;
  height: 84rpx;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.popup-cancel {
  background: var(--bg-page);
  color: var(--text-secondary);
  margin-right: var(--space-sm);
}

.popup-confirm {
  background: linear-gradient(135deg, var(--primary), #F09060);
  color: #fff;
}