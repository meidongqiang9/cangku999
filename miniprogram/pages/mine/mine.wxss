@import '../../theme.wxss';

page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding-bottom: var(--space-xl);
}

/* —— 用户信息卡 —— */
.profile-card {
  background: linear-gradient(160deg, #E8784A, #F09060, #F5A623);
  padding: var(--space-xl);
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-right: var(--space-md);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.profile-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 6rpx;
}

.last-order {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
}

/* —— 未登录卡片 —— */
.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  padding: var(--space-2xl) var(--space-md);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  background: var(--border-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-icon {
  font-size: 56rpx;
}

.nickname-placeholder {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--space-lg);
}

.login-btn {
  width: 70%;
  margin: 0;
  border-radius: var(--radius-full);
  background: #07C160;
}

/* —— 快捷入口 —— */
.quick-actions {
  margin-top: var(--space-md);
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--border-light);
}

.action-row:last-child {
  border-bottom: none;
}

.action-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.action-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.action-value.highlight {
  color: var(--primary);
  font-weight: 600;
}

.action-arrow {
  font-size: 36rpx;
  color: var(--border);
}

/* —— 订单历史 —— */
.history-section {
  margin-top: var(--space-lg);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 0 var(--space-md);
  margin-bottom: var(--space-sm);
}

.order-card {
  margin: 0 var(--space-md) var(--space-sm);
}

.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-table {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.order-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.order-status.paid {
  background: var(--success-light);
  color: var(--success);
}

.order-status.pending {
  background: var(--warning-light);
  color: var(--warning);
}

.order-items {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: var(--space-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.order-total {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

/* —— 退出登录 —— */
.logout-btn {
  margin: var(--space-2xl) var(--space-md);
  padding: var(--space-md);
  text-align: center;
  font-size: 28rpx;
  color: var(--danger);
  background: var(--bg-card);
  border-radius: var(--radius-md);
}

/* —— 隐私声明 —— */
.privacy-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  text-align: center;
  background: var(--bg-page);
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.privacy-link {
  font-size: 22rpx;
  color: #576B95;
}
