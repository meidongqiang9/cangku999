/* 全局样式 - 食易特 Eat */

page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
}

/* 容器 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 主按钮 */
.btn-primary {
  background: #5B8C5A;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 24rpx;
}

.btn-primary:active {
  opacity: 0.8;
  transition: opacity 100ms;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #999;
}

/* 次要按钮 */
.btn-secondary {
  background: #fff;
  color: #5B8C5A;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #5B8C5A;
}

/* 输入框 */
.input-field {
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.input-field input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

/* 价格 */
.price {
  color: #5B8C5A;
  font-weight: 600;
}

/* 文字 */
.text-secondary {
  color: #666;
}

.text-placeholder {
  color: #999;
}

.text-danger {
  color: #E74C3C;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 加载骨架 */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 弹层/遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 900;
  animation: mask-fade-in 200ms ease-out;
}

@keyframes mask-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹窗 */
.popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  animation: popup-slide-up 250ms ease-out;
}

@keyframes popup-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 标签 */
.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-green {
  background: #e8f5e9;
  color: #5B8C5A;
}

.tag-red {
  background: #ffebee;
  color: #E74C3C;
}

.tag-orange {
  background: #fff3e0;
  color: #FF8C42;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* 安全区适配 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
