page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-title {
  background: #5B8C5A;
  color: #fff;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

/* 桌号 */
.table-header {
  font-size: 28rpx;
  color: #666;
  padding: 24rpx;
}

/* 汇总表 */
.receipt-table {
  padding: 0;
  overflow: hidden;
}

.table-head {
  display: flex;
  padding: 20rpx 24rpx;
  background: #f0f7f0;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.table-group {
  border-bottom: 1rpx solid #f0f0f0;
}

.table-group:last-child {
  border-bottom: none;
}

.group-label {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  color: #999;
  background: #fafafa;
}

.table-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.table-row:last-child {
  border-bottom: none;
}

.col-name {
  flex: 2;
  font-size: 28rpx;
  color: #1a1a1a;
}

.col-qty {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.col-price {
  flex: 1.5;
  font-size: 26rpx;
  color: #666;
  text-align: right;
}

.col-subtotal {
  flex: 1.5;
  font-size: 28rpx;
  color: #5B8C5A;
  font-weight: 500;
  text-align: right;
}

/* 总计 */
.total-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
}

.total-label {
  font-size: 32rpx;
  font-weight: 600;
}

.total-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #5B8C5A;
}

/* 结账按钮 */
.pay-btn {
  margin: 40rpx 24rpx;
}

.pay-btn.disabled {
  background: #ccc;
  color: #999;
}

/* 返回订单 */
.back-link {
  text-align: center;
  padding: 20rpx;
  color: #5B8C5A;
  font-size: 28rpx;
}

/* 安全提示 */
.safety-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 22rpx;
  color: #ccc;
}
