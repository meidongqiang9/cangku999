@import '../../theme.wxss';

page { background: var(--bg-page) }

.container { padding: 30rpx; min-height: 100vh; background: var(--bg-page) }

.header {
  font-size: 36rpx;
  font-weight: bold;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

.section { margin-bottom: 30rpx }

.section-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 15rpx;
}

.input {
  border: 2rpx solid var(--border);
  padding: 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 15rpx;
  font-size: 28rpx;
  background: var(--bg-card);
}

.btn-group { display: flex; gap: 20rpx }

.btn {
  flex: 1;
  background: var(--bg-page);
  padding: 25rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-secondary);
}

.btn.primary {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.user-list { margin-top: var(--space-xl) }

.user-item {
  display: flex;
  justify-content: space-between;
  padding: 25rpx;
  border-bottom: 1rpx solid var(--border-light);
  background: var(--bg-card);
}

.user-name { font-size: 28rpx; color: var(--text-primary) }

.user-phone { color: var(--text-secondary); font-size: 24rpx }

.user-status { font-size: 24rpx; color: var(--text-tertiary) }

.user-status.disabled { color: var(--danger) }

.empty { text-align: center; color: var(--text-tertiary); padding: var(--space-xl) }

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 24, 16, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 900;
}

.modal-content {
  background: var(--bg-card);
  padding: var(--space-xl);
  border-radius: var(--radius-lg);
  width: 80%;
  box-shadow: var(--shadow-elevated);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: var(--text-primary);
}
