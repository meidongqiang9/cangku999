@import '../../../theme.wxss';

page { background: var(--bg-page) }
.container { min-height: 100vh; padding-bottom: 200rpx }

/* —— 顶部 —— */
.header {
  background: linear-gradient(160deg, #E8784A, #F09060);
  padding: var(--space-xl);
}
.title { font-size: 38rpx; font-weight: 800; color: #fff }

/* —— 总计 —— */
.total-row {
  background: var(--bg-card);
  margin: var(--space-md);
  padding: 28rpx var(--space-md);
  border-radius: var(--radius-lg);
  display: flex; justify-content: space-between;
  font-size: 34rpx; box-shadow: var(--shadow-card);
  color: var(--text-primary); font-weight: 500;
}
.total { font-size: 40rpx; font-weight: 800; color: var(--primary) }
.total.owner { color: var(--accent) }
.total.all { color: var(--text-primary) }
.owner-total { margin-top: 0; border-top: 1rpx dashed var(--border); border-radius: 0 }
.total-all { margin-top: 0; border-top: 2rpx solid var(--primary); border-radius: 0; font-weight: 700 }

/* —— 列表滚动区 —— */
.item-list {
  margin: 0 var(--space-md) var(--space-md);
  max-height: 60vh;
}

/* —— 分组卡片 —— */
.group-section {
  background: var(--bg-card);
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-lg);
  padding: 21rpx var(--space-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.section-head {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 17rpx; margin-bottom: 13rpx;
  border-bottom: 1rpx solid var(--border-light);
  font-size: 28rpx; font-weight: 700; color: var(--text-primary);
}
.section-subtotal { color: var(--primary); font-weight: 700; margin-right: 30rpx }

/* ====== 列宽（表头=顾客行=协助行，统一）====== */
.th-name, .td-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
.th-qty,  .td-qty  { width: 80rpx; flex-shrink: 0; text-align: center }
.th-price,.td-price{ width: 88rpx; flex-shrink: 0; text-align: center }
.th-sub,  .td-sub  { width: 84rpx; flex-shrink: 0; text-align: right; margin-right: 24rpx }

/* 终端协助输入框 — 与数据列等宽 */
.td-input-qty  { width: 80rpx; flex-shrink: 0; text-align: center }
.td-input-price{ width: 88rpx; flex-shrink: 0; text-align: center }

/* —— 表头 —— */
.table-header {
  display: flex; align-items: center;
  padding: 13rpx 0;
  font-size: 24rpx; color: var(--text-tertiary); font-weight: 600;
}

/* —— 数据行 —— */
.table-row {
  display: flex; align-items: center;
  padding: 17rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  font-size: 28rpx;
}
.table-row:last-child { border-bottom: none }

/* 终端协助行背景 */
.row-owner {
  background: var(--accent-light);
  margin: 0 -24rpx;
  padding-left: 24rpx; padding-right: 24rpx;
}

.td-name { font-weight: 500; color: var(--text-primary); font-size: 30rpx }
.td-qty  { color: var(--text-secondary); font-size: 28rpx }
.td-price{ color: var(--text-primary); font-size: 28rpx }
.td-sub  { color: var(--primary); font-weight: 700; font-size: 28rpx }

/* —— 终端协助输入框 —— */
.td-input-qty, .td-input-price {
  height: 52rpx; background: var(--bg-card);
  border: 2rpx solid var(--border); border-radius: 8rpx;
  font-size: 26rpx; font-weight: 600; color: var(--text-primary);
  padding: 0 4rpx; box-sizing: border-box;
}
.td-input-qty:focus, .td-input-price:focus {
  border-color: var(--primary);
}

/* —— 底部按钮 —— */
.btn-add {
  position: fixed; bottom: var(--space-xl);
  left: var(--space-md); right: var(--space-md);
  background: linear-gradient(135deg, var(--primary), #F09060);
  color: #fff; padding: 28rpx; border-radius: var(--radius-full);
  text-align: center; font-size: 32rpx; font-weight: 700;
  box-shadow: var(--shadow-button);
}
.btn-reset {
  position: fixed; bottom: 140rpx;
  left: var(--space-md); right: var(--space-md);
  background: var(--danger); color: #fff;
  padding: 28rpx; border-radius: var(--radius-full);
  text-align: center; font-size: 32rpx; font-weight: 700;
}