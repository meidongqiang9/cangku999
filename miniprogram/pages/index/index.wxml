<view class="container">
  <!-- 顶部海报轮播 -->
  <swiper class="banner-swiper" autoplay="{{true}}" interval="{{3000}}" circular="{{true}}">
    <swiper-item wx:for="{{banners}}" wx:key="*this">
      <image class="banner-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
    <swiper-item wx:if="{{banners.length === 0}}">
      <view class="banner-placeholder">
        <text class="banner-title">{{homeTitle}}</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 扫码按钮 -->
  <view class="scan-area" bindtap="scanCode">
    <view class="scan-icon">📷</view>
    <text class="scan-text">扫描桌面二维码</text>
  </view>

  <!-- 输入区域 -->
  <view class="input-section card">
    <view class="input-item">
      <view class="label">桌号/包房号</view>
      <input
        class="input"
        placeholder="请输入桌号或包房号"
        value="{{tableNo}}"
        bindinput="onTableInput"
        maxlength="10"
      />
    </view>
    <view class="input-item">
      <view class="label">就餐人数</view>
      <input
        class="input"
        placeholder="请输入就餐人数"
        value="{{guestCount}}"
        bindinput="onGuestInput"
        type="number"
        maxlength="2"
      />
    </view>
  </view>

  <!-- 继续上次点餐按钮 -->
  <view class="continue-btn" wx:if="{{hasActiveSession}}" bindtap="continueOrder">
    <text>继续上次点餐 ›</text>
  </view>

  <!-- 开始点餐按钮 -->
  <view
    class="btn-primary start-btn {{tableDisabled ? 'disabled' : ''}}"
    bindtap="{{tableDisabled ? '' : 'startOrder'}}"
  >
    开始点餐
  </view>

  <!-- 底部入口 -->
  <view class="bottom-entries">
    <view class="entry-item" bindtap="goMine">
      <text>我的</text>
    </view>
    <view class="entry-item" bindtap="goOwnerLogin">
      <text>管理入口</text>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="skeleton banner-skeleton"></view>
    <view class="skeleton input-skeleton"></view>
    <view class="skeleton btn-skeleton"></view>
  </view>
</view>
