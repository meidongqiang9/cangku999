.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx }

.page-title {
  background: linear-gradient(135deg, #5B8C5A 0%, #7BA37B 100%);
  padding: 30rpx;
  font-size: 32rpx; font-weight: bold;
  color: #fff;
}

.section {
  background: #fff;
  margin: 24rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-row.owner { background: #f0f7ff }

.item-name { flex: 1; font-size: 28rpx }

.item-qty { color: #999; width: 100rpx; text-align: center }

.item-subtotal { width: 100rpx; text-align: right; color: #5B8C5A; font-weight: bold }

.total-row {
  background: #fff;
  margin: 24rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: bold;
}

.total { color: #5B8C5A }

.btn-add {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  background: #5B8C5A;
  color: #fff;
  padding: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}