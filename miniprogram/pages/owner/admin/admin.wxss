.container { padding: 0 24rpx 120rpx; min-height: 100vh; background: #FBF7F0; }
.header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0 20rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #333; }
.header-actions { display: flex; gap: 20rpx; align-items: center; }
.btn-broadcast { font-size: 28rpx; color: #fff; background: #E8784A; padding: 12rpx 24rpx; border-radius: 10rpx; }
.btn-back { font-size: 28rpx; color: #999; padding: 12rpx 20rpx; }

.stats-row { display: flex; background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #E8784A; display: block; }
.stat-num.frozen { color: #E74C3C; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.search-bar { margin-bottom: 20rpx; }
.search-input { background: #fff; border-radius: 16rpx; padding: 24rpx; font-size: 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }

.owner-list { max-height: calc(100vh - 360rpx); }
.owner-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.owner-card.frozen { border-left: 6rpx solid #E74C3C; }
.owner-info { margin-bottom: 16rpx; }
.owner-name-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.owner-name { font-size: 32rpx; font-weight: 600; color: #333; }
.frozen-tag { font-size: 22rpx; color: #fff; background: #E74C3C; padding: 4rpx 12rpx; border-radius: 6rpx; }
.owner-phone { font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.owner-meta { display: flex; flex-wrap: wrap; gap: 16rpx; }
.meta-item { font-size: 24rpx; color: #999; }

.owner-actions { display: flex; gap: 16rpx; }
.action-btn { font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 10rpx; color: #fff; }
.action-btn.recharge { background: #27AE60; }
.action-btn.unfreeze { background: #27AE60; }
.action-btn.freeze { background: #E74C3C; }
.action-btn.notify { background: #3498DB; }

.empty { text-align: center; color: #999; padding: 80rpx 0; font-size: 28rpx; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-popup { position: fixed; top: 30%; left: 50%; transform: translateX(-50%); background: #fff; border-radius: 20rpx; padding: 40rpx; width: 600rpx; z-index: 101; }
.modal-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; text-align: center; }
.modal-input { border: 2rpx solid #eee; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; margin-bottom: 24rpx; }
.modal-textarea { border: 2rpx solid #eee; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; height: 200rpx; margin-bottom: 24rpx; width: 100%; box-sizing: border-box; }
.modal-btns { display: flex; justify-content: flex-end; gap: 20rpx; }
.modal-btn { font-size: 28rpx; padding: 16rpx 36rpx; border-radius: 10rpx; }
.modal-btn.cancel { color: #999; background: #f5f5f5; }
.modal-btn.confirm { color: #fff; background: #E8784A; }