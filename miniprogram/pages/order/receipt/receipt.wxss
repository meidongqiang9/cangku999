@import '../../../theme.wxss';

page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding-bottom: var(--space-xl);
}

/* —— 顶部 —— */
.page-title {
  background: linear-gradient(160deg, #E8784A, #F09060);
  color: #fff;
  padding: 28rpx var(--space-md);
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.table-header {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: var(--space-md);
  font-weight: 500;
}

/* —— 汇总表 —— */
.receipt-table {
  padding: 0;
  overflow: hidden;
}

.table-head {
  display: flex;
  padding: 22rpx var(--space-md);
  background: var(--primary-light);
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 700;
}

.table-group {
  border-bottom: 1rpx solid var(--border-light);
}

.table-group:last-child { border-bottom: none; }

.group-label {
  padding: 14rpx var(--space-md);
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: #FAFAF8;
  font-weight: 600;
}
.group-subtotal {
  float: right;
  color: var(--primary);
  font-weight: 700;
  font-size: 24rpx;
}

.table-row {
  display: flex;
  padding: 22rpx var(--space-md);
  border-bottom: 1rpx solid var(--border-light);
}

.table-row:last-child { border-bottom: none; }

.col-name {
  flex: 2;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.col-name-wrap {
  flex: 2;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.col-name-wrap .col-name {
  flex: none;
}

.taste-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.col-qty {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

.col-price {
  flex: 1.5;
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: right;
}

.col-subtotal {
  flex: 1.5;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
  text-align: right;
}

/* —— 总计 —— */
.total-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-md);
}

.total-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.total-value {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary);
}

/* —— 结账按钮 —— */
.pay-btn {
  margin: var(--space-xl) var(--space-md);
}

.pay-btn.disabled {
  background: #D5CFC8;
  color: var(--text-tertiary);
  box-shadow: none;
}

/* —— 返回链接 —— */
.back-link {
  text-align: center;
  padding: 24rpx;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}

/* —— 安全提示 —— */
.safety-tip {
  text-align: center;
  padding: var(--space-md);
  font-size: 22rpx;
  color: var(--text-tertiary);
}