page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 未登录卡片 */
.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  padding: 48rpx 24rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-icon {
  font-size: 56rpx;
}

.nickname-placeholder {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.login-btn {
  width: 70%;
  margin: 0;
  border-radius: 40rpx;
  background: #07C160;
}

/* 用户信息卡 */
.profile-card {
  background: linear-gradient(135deg, #5B8C5A, #7BA37B);
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  margin-right: 24rpx;
}

.profile-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 6rpx;
}

.last-order {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 快捷入口 */
.quick-actions {
  margin-top: 24rpx;
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.action-row:last-child {
  border-bottom: none;
}

.action-label {
  font-size: 28rpx;
  color: #333;
}

.action-value {
  font-size: 28rpx;
  color: #999;
}

.action-value.highlight {
  color: #5B8C5A;
  font-weight: 600;
}

.action-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 订单历史 */
.history-section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.order-card {
  margin: 0 24rpx 16rpx;
}

.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-table {
  font-size: 28rpx;
  font-weight: 500;
}

.order-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.order-status.paid {
  background: #e8f5e9;
  color: #5B8C5A;
}

.order-status.pending {
  background: #fff3e0;
  color: #FF8C42;
}

.order-items {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 22rpx;
  color: #ccc;
}

.order-total {
  font-size: 28rpx;
  color: #5B8C5A;
  font-weight: 500;
}

/* 退出登录 */
.logout-btn {
  margin: 48rpx 24rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #E74C3C;
  background: #fff;
  border-radius: 16rpx;
}

/* 隐私声明 */
.privacy-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  text-align: center;
  background: #f5f5f5;
}

.privacy-footer text {
  font-size: 20rpx;
  color: #ccc;
}
