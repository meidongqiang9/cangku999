@import '../../theme.wxss';

page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  position: relative;
}

/* —— 轮播海报 —— */
.banner-swiper {
  width: 100%;
  height: 380rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 380rpx;
  background: linear-gradient(160deg, #E8784A 0%, #F09060 40%, #F5A623 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
}

/* —— 扫码区域 —— */
.scan-area {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx var(--space-md);
  margin: -8rpx var(--space-md) 0;
  background: var(--bg-card);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.scan-icon {
  font-size: 40rpx;
  margin-right: var(--space-sm);
}

.scan-text {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

/* —— 输入区域 —— */
.input-section {
  margin: var(--space-lg) var(--space-md);
  padding: var(--space-lg);
}

.input-item {
  margin-bottom: 20rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  font-weight: 600;
}

.input {
  width: 100%;
  height: 92rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  font-size: 34rpx;
  box-sizing: border-box;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  transition: border-color 200ms, background 200ms;
}

.input:focus {
  border-color: var(--primary);
  background: var(--bg-card);
}

/* 桌号锁定态 */
.table-locked-wrap {
  position: relative;
}

.table-locked-wrap.locked .input {
  background: #F5F2EE;
  color: var(--text-secondary);
}

.input-locked {
  padding-right: 60rpx !important;
}

.lock-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
}

/* —— 继续点餐 —— */
.continue-btn {
  margin: 0 var(--space-md) var(--space-sm);
  padding: var(--space-md);
  background: var(--accent-light);
  border-radius: var(--radius-md);
  text-align: center;
}

.continue-btn text {
  color: #B87A14;
  font-size: 28rpx;
  font-weight: 600;
}

/* —— 开始点餐按钮 —— */
.start-btn {
  margin: var(--space-lg) var(--space-md);
}

.start-btn.disabled {
  background: #D5CFC8;
  box-shadow: none;
}

/* —— 底部入口 —— */
.bottom-entries {
  display: flex;
  justify-content: center;
  padding: var(--space-lg);
  gap: 60rpx;
}

.entry-item {
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* —— 骨架屏 —— */
.loading-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--bg-page);
  z-index: 999;
  padding: var(--space-md);
}

.banner-skeleton { height: 380rpx; border-radius: 0; }
.input-skeleton { height: 240rpx; margin: var(--space-lg) 0; border-radius: var(--radius-md); }
.btn-skeleton { height: 88rpx; margin-top: var(--space-lg); border-radius: var(--radius-full); }

/* —— 通知弹窗 —— */
.notice-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1100;
}

.notice-popup {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 580rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  z-index: 1200;
  overflow: hidden;
  box-shadow: var(--shadow-elevated);
  animation: notice-pop 250ms ease-out;
}

@keyframes notice-pop {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.88); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

.notice-title {
  background: linear-gradient(160deg, #E8784A, #F09060);
  color: #fff;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.notice-body {
  padding: 40rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: pre-wrap;
  word-break: break-all;
}

.notice-btn {
  margin: 0 32rpx 32rpx;
  background: linear-gradient(135deg, #E8784A, #F09060);
  color: #fff;
  padding: 22rpx;
  border-radius: var(--radius-full);
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}

.notice-btn:active {
  opacity: 0.85;
}